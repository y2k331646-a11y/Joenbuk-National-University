# Anthropic API 키 (https://console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=sk-ant-...

# 사용할 Claude 모델
CLAUDE_MODEL=claude-opus-4-8

# 병원 이름 (페르소나와 인사말에 사용)
HOSPITAL_NAME=전북대학교병원

# (선택) 기본 병원 안내 페르소나를 완전히 교체하고 싶을 때만 설정
# SYSTEM_PROMPT=...

# 카카오 스킬 응답 제한(5초) 안에서 Claude 응답을 기다릴 최대 시간(초)
SYNC_TIMEOUT_SECONDS=4.2

# 사용자별로 기억할 최근 대화 턴 수
MAX_HISTORY_TURNS=10
