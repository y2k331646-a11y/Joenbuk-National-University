# Anthropic API 키 (https://console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=sk-ant-...

# 사용할 Claude 모델
CLAUDE_MODEL=claude-opus-4-8

# 챗봇 페르소나 (시스템 프롬프트)
SYSTEM_PROMPT=당신은 카카오톡에서 대화하는 친절한 AI 비서입니다. 답변은 한국어로, 간결하게 작성하세요.

# 카카오 스킬 응답 제한(5초) 안에서 Claude 응답을 기다릴 최대 시간(초)
SYNC_TIMEOUT_SECONDS=4.2

# 사용자별로 기억할 최근 대화 턴 수
MAX_HISTORY_TURNS=10
